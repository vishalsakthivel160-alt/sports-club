# Backend API base URL.
# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production set it to your deployed backend, e.g. https://smash-masters-api.onrender.com/api
VITE_API_URL=

# Public URL of the frontend (used for canonical + Open Graph URLs)
VITE_SITE_URL=

# Optional: Google Maps "Share > Embed a map" iframe URL (the src="..." value).
# Leave empty to show the clean placeholder instead.
VITE_MAPS_EMBED_URL=
